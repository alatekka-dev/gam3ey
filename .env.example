# Copy to .env (optional). Every value has a safe local default.
PORT=4000
# Change in any shared or hosted deployment:
JWT_SECRET=replace-with-a-long-random-string
# Leave empty to use the embedded PostgreSQL (PGlite) stored in server/data/.
# Set to a PostgreSQL connection string to use an external server instead.
DATABASE_URL=
# Optional: enables language-model phrasing for the study assistant.
# Without it the assistant answers by direct retrieval from lectures.
ANTHROPIC_API_KEY=
